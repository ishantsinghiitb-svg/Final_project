# Supabase
# Find these in your Supabase project: Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Module 6A · AI Foundation (server-only) ──
# These are SECRETS — do NOT prefix with VITE_ (that would ship them to the
# browser). In dev they come from the Node process env; in production set them
# as Cloudflare Worker secrets: `npx wrangler secret put OPENAI_API_KEY`, etc.
OPENAI_API_KEY=your-openai-api-key
# Optional alternate providers (stubs in the MVP):
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# Optional: service-role client for privileged server paths (bypasses RLS).
# SUPABASE_SERVICE_ROLE_KEY=

# ── Module 6A · AI config (isomorphic, safe to expose) ──
# Default AI provider: openai | anthropic | gemini
VITE_AI_DEFAULT_PROVIDER=openai
# Free AI generations per new user before the feature locks.
VITE_AI_FREE_CREDITS=5

# ── Module 9A · Gmail Intelligence (server-only) ──
# From a Google Cloud project's OAuth 2.0 Web application client (Console →
# APIs & Services → Credentials). Consent screen scope: gmail.readonly only.
# Keep the consent screen in "Testing" publishing status (up to 100 test
# users) unless you need full production verification (gmail.readonly is a
# Google "Restricted" scope requiring an annual CASA security assessment to
# verify beyond that).
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must exactly match a redirect URI registered on the OAuth client. This
# repo's dev server port isn't fixed in vite.config.ts (it's resolved by the
# @lovable.dev/vite-tanstack-config wrapper's own sandbox detection) — check
# the actual "Local:" URL vite dev prints on startup and use that origin.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/auth/gmail/callback
# Two SEPARATE secrets (never reuse one for both purposes). MUST be standard
# base64 (not hex, not base64url, not a raw passphrase) encoding EXACTLY 32
# raw bytes — both are imported directly as key material via Web Crypto
# (see src/server/gmail/TokenCrypto.ts / OAuthState.ts), and AES-256-GCM
# specifically will throw if the decoded length isn't exactly 32 bytes.
# Generate with: openssl rand -base64 32  (NOT -hex)
GMAIL_TOKEN_ENCRYPTION_KEY=
# Signs the stateless OAuth `state` CSRF parameter.
GMAIL_OAUTH_STATE_SECRET=
