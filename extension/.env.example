# App
VITE_APP_ENV=development

# Supabase — must match the main OfferLyst app's project
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# OfferLyst web app origin this build talks to — used for "Open in OfferLyst"
# navigation (${VITE_APP_URL}/dashboard/...) AND the /api/extension/* fetches.
#
# Copy this file to `.env` for LOCAL DEVELOPMENT and leave the localhost value
# below. Production builds do NOT use this: `.env.production` (committed) pins
# the deployed origin and overrides `.env` whenever `vite build` runs.
#
# Update only if your local web app serves on a different port/host.
VITE_APP_URL=http://localhost:8080
